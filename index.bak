  {
    "section": "Desserts",
    "name": "Red Velvet",
    "price": 50,
    "image": "images/red-velvet.jfif"
  }
];
let cart = JSON.parse(localStorage.getItem("radioCafeCart") || "[]");

function money(v){ return typeof v === "number" ? v + " EGP" : v + " EGP"; }
function save(){localStorage.setItem("radioCafeCart",JSON.stringify(cart));renderCount();}
function renderCount(){document.getElementById("count").textContent=cart.reduce((s,i)=>s+i.qty,0)}
function add(i){const p=products[i];const x=cart.find(a=>a.i===i);if(x)x.qty++;else cart.push({i,qty:1});save();const b=document.querySelectorAll(".add")[i];if(b){b.textContent="ADDED ✓";b.classList.add("added");setTimeout(()=>{b.textContent="+ ADD TO ORDER";b.classList.remove("added")},700)}}
function slugify(s){return s.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"")}

function addSized(baseIndex,size){
 const p=products[baseIndex];
 const price = size === "S" ? p.priceS : p.priceD;
 const variantName = `${p.name} (${size})`;
 let idx = products.findIndex(x=>x._variantOf===baseIndex && x._size===size);
 if(idx===-1){
   products.push({...p,name:variantName,price, _variantOf:baseIndex, _size:size});
   idx=products.length-1;
 }
 const x=cart.find(a=>a.i===idx);
 if(x)x.qty++; else cart.push({i:idx,qty:1});
 save();
}

function renderMenu(){
 const groups={};
 products.forEach((p,i)=>(groups[p.section]??=[]).push({...p,i}));
 const entries=Object.entries(groups);
 document.getElementById("categoryNav").innerHTML=entries.map(([section])=>`<a href="#section-${slugify(section)}">${section}</a>`).join("");
 document.getElementById("menu").innerHTML=entries.map(([section,items])=>`<section class="section" id="section-${slugify(section)}"><h2 class="section-title"><a href="#section-${slugify(section)}">${section}</a></h2><div class="grid">${items.map(p=>`<article class="card"><div class="photo"><img src="${p.image}" alt="${p.name}" loading="lazy"></div><div class="info"><div class="name">${p.name}</div><div class="price">${money(p.price)}</div>
${(p.priceS!=null||p.priceD!=null)?`<div class="size-options">
<button class="size-btn" onclick="addSized(${p.i},'S')">S · ${money(p.priceS)}</button>
<button class="size-btn" onclick="addSized(${p.i},'D')">D · ${money(p.priceD)}</button>
</div>`:`<button class="add" onclick="add(${p.i})">+ ADD TO ORDER</button>`}</div></article>`).join("")}</div></section>`).join("");
}
function openCart(){renderCart();document.getElementById("overlay").classList.add("show")}
function closeCart(){document.getElementById("overlay").classList.remove("show")}
function renderCart(){
 const box=document.getElementById("orderItems");
 if(!cart.length){box.innerHTML='<div class="empty">Your order is empty.<br>Add something delicious from the menu.</div>';document.getElementById("total").textContent="0 EGP";return}
 let total=0;
 box.innerHTML=cart.map((x,k)=>{const p=products[x.i];let unit=typeof p.price==="number"?p.price:parseInt(p.price);total+=unit*x.qty;return `<div class="order-row"><div>${p.name}<br><small>${p.price} EGP</small></div><div class="qty"><button onclick="changeQty(${k},-1)">−</button>${x.qty}<button onclick="changeQty(${k},1)">+</button></div><strong>${unit*x.qty} EGP</strong><button class="remove" onclick="removeItem(${k})">✕</button></div>`}).join("");
 document.getElementById("total").textContent=total+" EGP";
}
function changeQty(k,d){cart[k].qty+=d;if(cart[k].qty<=0)cart.splice(k,1);save();renderCart()}
function removeItem(k){cart.splice(k,1);save();renderCart()}
function sendOrder(){
 if(!cart.length){alert("Please add at least one item.");return}
 const name=document.getElementById("customerName").value.trim();
 const table=document.getElementById("tableNumber").value.trim();
 if(!name||!table){alert("Please enter your name and table number.");return}
 let total=0;
 let lines=cart.map(x=>{const p=products[x.i];const unit=typeof p.price==="number"?p.price:parseInt(p.price);total+=unit*x.qty;return `• ${p.name} × ${x.qty} — ${unit*x.qty} EGP`}).join("\n");
 const text=`*RADIO CAFE — NEW ORDER*\n\nName: ${name}\nTable: ${table}\n\n*Order:*\n${lines}\n\n*Total: ${total} EGP*`;
 const url=`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
 window.open(url,"_blank");
}
renderMenu();renderCount();
</script>
</body>
</html>