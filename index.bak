    "name": "Chocolate Flutes",
    "price": 50,
    "image": "images/chocolate-flutes.jfif"
  },
  {
    "section": "Desserts",
    "name": "Molten Cake",
    "price": 60,
    "image": "images/molten-cake.webp"
