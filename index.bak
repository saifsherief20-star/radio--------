<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RADIO CAFE — Menu</title>
<meta name="theme-color" content="#5a3b2e">
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@400;500;600;700&display=swap');
:root{--cream:#f3eadb;--paper:#fbf7f0;--brown:#5a3b2e;--brown2:#76523f;--ink:#2c211b;--line:#dfd1be;--shadow:0 12px 32px rgba(68,43,29,.12)}
*{box-sizing:border-box} body{margin:0;background:var(--cream);color:var(--ink);font-family:Montserrat,Arial,sans-serif}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 15% 10%,rgba(255,255,255,.55),transparent 28%),radial-gradient(circle at 90% 90%,rgba(90,59,46,.08),transparent 30%)}
header{padding:54px 18px 30px;text-align:center;animation:rise .7s ease both}
.brand{display:inline-flex;align-items:center;gap:12px;color:var(--brown);font-family:"Cormorant Garamond",serif;font-size:54px;line-height:1;font-weight:700;letter-spacing:5px}
.brand:before,.brand:after{content:"";display:block;width:48px;height:1px;background:var(--brown2)}
.tag{margin:13px 0 0;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--brown2)}
main{width:min(1180px,94%);margin:auto;padding-bottom:120px}
.section{margin:28px 0 50px;animation:rise .65s ease both}
.section-title{display:flex;align-items:center;gap:14px;margin:0 0 20px;font-family:"Cormorant Garamond",serif;font-size:34px;color:var(--brown)}
.section-title:after{content:"";height:1px;background:var(--line);flex:1}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:18px}
.card{background:rgba(251,247,240,.94);border:1px solid rgba(90,59,46,.1);border-radius:18px;overflow:hidden;box-shadow:var(--shadow);transition:.25s;display:flex;flex-direction:column}
.card:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(68,43,29,.18)}
.photo{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:#f7f0e6;padding:8px;overflow:hidden}
.photo img{width:100%;height:100%;object-fit:contain;display:block}
.info{padding:14px 14px 15px;display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center}
.name{font-size:13px;font-weight:600;line-height:1.35}
.price{font-family:"Cormorant Garamond",serif;font-size:22px;font-weight:700;color:var(--brown);white-space:nowrap}
.add{grid-column:1/-1;border:0;border-radius:11px;padding:10px;background:var(--brown);color:#fff8ee;font:600 11px Montserrat;letter-spacing:1.5px;cursor:pointer;transition:.2s}
.add:hover{background:#42291f} .add.added{background:var(--brown2)}
.cart{position:fixed;right:22px;bottom:22px;z-index:10;border:0;border-radius:18px;background:var(--brown);color:#fff8ee;padding:16px 20px;min-width:210px;box-shadow:0 12px 30px rgba(47,29,21,.3);font:700 12px Montserrat;letter-spacing:1.4px;cursor:pointer}
.cart span{display:inline-flex;min-width:22px;height:22px;border-radius:50%;align-items:center;justify-content:center;background:#fff8ee;color:var(--brown);margin-left:7px}
.overlay{position:fixed;inset:0;background:rgba(33,23,18,.58);display:none;z-index:20;padding:18px;align-items:flex-end;justify-content:center}
.overlay.show{display:flex} .modal{width:min(600px,100%);max-height:90vh;overflow:auto;background:var(--paper);border-radius:24px 24px 0 0;padding:24px;animation:up .3s ease}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
.modal h2{font-family:"Cormorant Garamond",serif;font-size:34px;color:var(--brown);margin:0}
.close{border:0;background:#eee1d1;border-radius:50%;width:36px;height:36px;cursor:pointer;color:var(--brown);font-size:20px}
.order-row{display:grid;grid-template-columns:1fr auto auto auto;gap:8px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line);font-size:12px}
.qty{display:flex;align-items:center;gap:7px} .qty button{border:0;background:#e8dac8;color:var(--brown);width:28px;height:28px;border-radius:8px;cursor:pointer;font-weight:700}
.remove{border:0;background:transparent;color:#9a6b58;cursor:pointer}
.total{display:flex;justify-content:space-between;padding:18px 0;font-weight:700;color:var(--brown)}
.field{margin-top:12px} label{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;color:var(--brown2)} input{width:100%;padding:13px;border:1px solid var(--line);border-radius:11px;background:#fffdf9;outline:none;font:14px Montserrat} input:focus{border-color:var(--brown2)}
.send{width:100%;margin-top:18px;border:0;border-radius:13px;background:var(--brown);color:white;padding:15px;font:700 12px Montserrat;letter-spacing:1.5px;cursor:pointer}
.note{font-size:10px;color:#8a7669;text-align:center;margin:10px 0 0;line-height:1.5}
.empty{padding:24px;text-align:center;color:#8a7669;font-size:13px}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}} @keyframes up{from{transform:translateY(30px);opacity:.6}to{transform:none;opacity:1}}
@media(max-width:560px){.brand{font-size:43px}.brand:before,.brand:after{width:24px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.card{border-radius:14px}.photo{padding:5px}.info{padding:10px}.name{font-size:11px}.price{font-size:19px}.add{padding:9px 5px;font-size:9px}.cart{left:15px;right:15px;bottom:14px;width:calc(100% - 30px)}}

.category-nav{position:sticky;top:0;z-index:9;width:min(1180px,94%);margin:0 auto 18px;padding:10px 0;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;background:rgba(243,234,219,.92);backdrop-filter:blur(10px)}
.category-nav::-webkit-scrollbar{display:none}
.category-nav a{flex:0 0 auto;text-decoration:none;color:var(--brown);border:1px solid var(--line);background:rgba(251,247,240,.9);padding:9px 13px;border-radius:999px;font:600 10px Montserrat;letter-spacing:.8px;text-transform:uppercase;transition:.2s}
.category-nav a:hover{background:var(--brown);color:#fff8ee}
.section-title{cursor:pointer}
.section-title a{color:inherit;text-decoration:none}
.location-wrap{display:flex;justify-content:center;padding:5px 0 125px}
.location-btn{display:inline-flex;align-items:center;gap:10px;text-decoration:none;border:0;border-radius:15px;background:var(--brown);color:#fff8ee;padding:16px 26px;box-shadow:0 10px 25px rgba(47,29,21,.2);font:700 12px Montserrat;letter-spacing:1.5px;transition:.2s}
.location-btn:hover{transform:translateY(-2px);background:#42291f}

.size-options{display:flex;gap:7px;margin:8px 0 10px}
.size-btn{border:1px solid var(--brown);background:#fff8ee;color:var(--brown);border-radius:9px;padding:7px 12px;cursor:pointer;font:700 11px Montserrat;transition:.15s}
.size-btn:hover,.size-btn.active{background:var(--brown);color:#fff8ee}
</style>
</head>
<body>
<header>
  <div class="brand">RADIO</div>
  <div class="tag">CAFE · COFFEE · MORE</div>
</header>
<nav class="category-nav" id="categoryNav"></nav>
<main id="menu"></main>
<div class="location-wrap">
  <a class="location-btn" href="https://www.google.com/maps/search/?api=1&query=RADIO+CAFE" target="_blank" rel="noopener">
    <span>⌖</span> VIEW LOCATION
  </a>
</div>
<button class="cart" onclick="openCart()">VIEW ORDER / CART <span id="count">0</span></button>
<div class="overlay" id="overlay" onclick="if(event.target===this)closeCart()">
  <div class="modal">
    <div class="modal-head"><h2>Your Order</h2><button class="close" onclick="closeCart()">×</button></div>
    <div id="orderItems"></div>
    <div class="total"><span>Total</span><span id="total">0 EGP</span></div>
    <div class="field"><label>Your Name</label><input id="customerName" placeholder="Enter your name"></div>
    <div class="field"><label>Table Number</label><input id="tableNumber" placeholder="e.g. 12"></div>
    <button class="send" onclick="sendOrder()">SEND ORDER ON WHATSAPP</button>
    <p class="note">No phone number is required. Your order will open in WhatsApp with the selected items.</p>
  </div>
</div>
<script>
const WHATSAPP_NUMBER = "201000000000"; // Replace with RADIO CAFE WhatsApp number, digits only.
const products = [
