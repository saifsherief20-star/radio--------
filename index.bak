  },
  {
    "section": "Juices & Smoothies",
    "name": "Kiwi",
    "price": 60,
    "image": "images/kiwi.jpg"
  },
  {
    "section": "Juices & Smoothies",
    "name": "Mango",
    "price": 50,
    "image": "images/mango.jpg"
  },
  {
    "section": "Juices & Smoothies",
    "name": "Mint Smoothie",
    "price": 60,
    "image": "images/mint-smoothie.jpg"
  },
  {
    "section": "Juices & Smoothies",
    "name": "Strawberry",
    "price": 50,
    "image": "images/strawberry-juice.jpg"
  },
  {
    "section": "Juices & Smoothies",
    "name": "Watermelon",
    "price": 50,
    "image": "images/watermelon.jpg"
  },
  {
