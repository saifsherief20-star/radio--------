    "image": "images/banana-berry.jpg"
  },
  {
    "section": "Juices & Smoothies",
    "name": "Blueberry",
    "price": 60,
    "image": "images/blueberry.jpg"
  },
  {
    "section": "Juices & Smoothies",
    "name": "Guava Blueberry",
    "price": 60,
